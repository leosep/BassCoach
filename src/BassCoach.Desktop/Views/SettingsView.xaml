<UserControl x:Class="BassCoach.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Settings" />
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Audio" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Input (plug your bass into input 1)" />
                    <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Output (headphones or speakers)" />
                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Number of strings" />
                    <ComboBox ItemsSource="{Binding StringOptions}" SelectedItem="{Binding StringCount}" Width="120" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Sensitivity, StringFormat=Input sensitivity: {0:P0}}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Sensitivity}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding BackingVolume, StringFormat=Backing band volume: {0:P0}}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding BackingVolume}" />
                    <CheckBox Content="Play a bass guide note on beats 1 and 3" IsChecked="{Binding BassGuide}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Timing" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Your audio device adds a small delay. If the results say you are always late or always early, correct it here, or press «Calibrate» at the end of a session where you played on the beat." />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding LatencyMs, StringFormat=Latency compensation: {0:0} ms}" />
                    <Slider Minimum="0" Maximum="400" Value="{Binding LatencyMs}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Check your input" />
                    <Button Content="{Binding MonitorButtonText}" Command="{Binding ToggleMonitorCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding DetectedText}" FontSize="40" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Level, Mode=OneWay}" Height="10" Margin="0,6,0,0" />
                    <Slider Minimum="-50" Maximum="50" Value="{Binding Cents, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"
                            TickFrequency="25" TickPlacement="BottomRight" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Muted}" Text="Flat   ·   in tune   ·   Sharp" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="Save settings" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource Muted}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
