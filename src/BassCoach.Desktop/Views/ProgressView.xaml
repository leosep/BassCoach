<UserControl x:Class="BassCoach.Desktop.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Progress" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Headline}" Margin="0,4,0,18" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ListView ItemsSource="{Binding Sessions}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="When" Width="170" DisplayMemberBinding="{Binding When}" />
                        <GridViewColumn Header="Exercise" Width="230" DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="Accuracy" Width="100" DisplayMemberBinding="{Binding Accuracy}" />
                        <GridViewColumn Header="Timing" Width="110" DisplayMemberBinding="{Binding Timing}" />
                        <GridViewColumn Header="Stars" Width="100" DisplayMemberBinding="{Binding Stars}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
