<?xml version="1.0" encoding="utf-8"?>
<!--
  Bass Coach MSI installer (WiX v4+ / v7).

  Build:
    wix build installer\BassCoach.wxs -d AppVersion=1.0.2 -d PublishDir=<absolute path to publish>
              -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
              -o dist\Install-BassCoach-1.0.2-x64.msi

  Installer behaviour:
  * Per-user by default (no administrator rights), per-machine with ALLUSERS=1.
  * Start Menu shortcut always; desktop shortcut is a feature the user can clear.
  * The finish page launches the app unless the user clears "Open Bass Coach now".

  Windows detection notes (the parts that are easy to get wrong):
  * Do NOT test VersionNT >= 1000 to mean "Windows 10 or 11". Windows Installer's own
    msiexec.exe manifest only declares Windows 8.1, so inside every MSI (UI and execute
    sequence) VersionNT is capped at 603 and WindowsBuild at 9600 on Windows 10/11.
    Microsoft documents this: "the VersionNT value is 603 for Windows 10" (KB3202260).
  * The reliable in-MSI test is the CurrentMajorVersionNumber DWORD under
    HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion. It does not exist before
    Windows 10 and is 10 on both Windows 10 and Windows 11 (Windows 11 is build 22000+,
    but its major version is still 10).
  * Architecture is enforced by the package itself. This MSI is built with -arch x64, so
    its Template Summary is "x64;1033" and Windows Installer refuses to run it on a
    platform that cannot execute x64 code (for example Windows 10 on ARM64). Do not test
    Msix64 for this: Windows 11 on ARM64 sets Msix64 because it emulates x64, and the
    win-x64 build does run there.
  * Installed is included in the launch conditions so repair and uninstall still work
    if the OS is upgraded/downgraded after installation.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?ifndef AppVersion ?>
    <?define AppVersion = "1.0.0" ?>
  <?endif?>

  <?ifndef PublishDir ?>
    <?define PublishDir = "..\publish" ?>
  <?endif?>

  <Package Name="Bass Coach"
           Manufacturer="Bass Coach"
           Version="$(var.AppVersion)"
           Language="1033"
           UpgradeCode="B7C1E2A4-5D93-4F0A-9E61-2A8F4C7D1B30"
           Scope="perUserOrMachine"
           Compressed="yes">

    <SummaryInformation Description="Bass Coach - practice bass with a backing band and instant feedback."
                        Manufacturer="Bass Coach" />

    <!--
      Dual-purpose package: per-user by default (no administrator rights, same behaviour as
      the old Inno Setup build), but a per-machine install is still possible with ALLUSERS=1.
      ProgramFiles6432Folder redirects to %LocalAppData%\Programs for the per-user case.
    -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Bass Coach is already installed."
                  MigrateFeatures="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Windows 10 or 11. VersionNT is capped at 603 inside an MSI, so read the real build
      number from the registry instead. CurrentBuildNumber is 9600 on Windows 8.1 and
      10240+ on Windows 10 (19041+ on recent releases, 22000+ on Windows 11), so a numeric
      ">= 10240" test is exactly "Windows 10 or later" and stays correct for future builds.
      AppSearch runs before LaunchConditions in both the UI and execute sequences, so the
      property is populated in silent installs too.
    -->
    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="WindowsBuildNumberSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR WINDOWSBUILDNUMBER &gt;= 10240"
            Message="Bass Coach requires Windows 10 or Windows 11." />

    <!--
      No architecture launch condition is needed: the package Template is x64, which
      Windows Installer enforces before any action runs. See the header comment for why
      Msix64 must not be used to detect ARM64.
    -->

    <Icon Id="BassCoach.exe" SourceFile="$(var.PublishDir)\BassCoach.exe" />
    <Property Id="ARPPRODUCTICON" Value="BassCoach.exe" />

    <!--
      Advertised shortcuts are used so ICE57 can see that the shortcut scope matches the
      file keypath. Windows Installer turns them back into normal .lnk files at install
      time, so the user gets ordinary shortcuts.
    -->
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

    <!-- Launch the app from the finish page. The checkbox is checked by default. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Bass Coach now" />

    <!--
      WixUI_FeatureTree instead of WixUI_Minimal so the optional desktop shortcut can be a
      check box, like the "Create a desktop shortcut" task in the old Inno Setup build.
      The shortcut lives in its own feature, which is selected by default and may be cleared.
    -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />

    <!--
      "Open Bass Coach now" is a check box on the finish page. The check box lives in the UI
      sequence, so the app must be launched from the Finish button (DoAction), not from a
      custom action after InstallFinalize: the execute sequence finishes before the finish
      page is even shown, so an execute-sequence action would ignore the check box.
      Silent installs (UILevel < 3) never show the page and therefore never launch the app.
    -->
    <Property Id="WixShellExecTarget" Value="[#BassCoachExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <UI Id="BassCoachUI">
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Bass Coach">
        <Component Id="MainExecutable" Guid="5D2F2A0B-9A52-4D7B-8C1E-3A6C7F0E2B11">
          <File Id="BassCoachExe" Source="$(var.PublishDir)\BassCoach.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="Bass Coach"
                      Description="Practice bass with a backing band and instant feedback"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="BassCoach.exe"
                      Advertise="yes" />
          </File>
        </Component>
        <Component Id="DesktopShortcutComponent" Guid="9C4E6A12-7B3D-4F58-A1C2-8D5E0B7F3A64" Directory="DesktopFolder">
          <!-- The registry value is the component keypath, so the shortcut can be optional. -->
          <RegistryValue Root="HKCU"
                         Key="Software\BassCoach"
                         Name="DesktopShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <Shortcut Id="DesktopShortcut"
                    Name="Bass Coach"
                    Target="[INSTALLFOLDER]BassCoach.exe"
                    Description="Practice bass with a backing band and instant feedback"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="BassCoach.exe" />
        </Component>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\BassCoach.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="MainFeature"
             Title="Bass Coach"
             Description="The Bass Coach application and all required runtime files."
             Level="1"
             AllowAbsent="no">
      <ComponentRef Id="MainExecutable" />
      <ComponentGroupRef Id="AppFiles" />
      <!--
        Optional desktop shortcut. Level 1 + AllowAbsent means it is installed by default but
        the user can clear it in the feature tree, exactly like the old Inno Setup task.
      -->
      <Feature Id="DesktopShortcutFeature"
               Title="Desktop shortcut"
               Description="Add a Bass Coach shortcut to the desktop."
               Level="1"
               AllowAbsent="yes">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
    </Feature>
  </Package>
</Wix>
